# Upstash Redis (shared instance, scotusgami: key prefix)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Bearer secret for /api/refresh (Vercel cron sends it automatically)
CRON_SECRET=

# Shared secret for the /admin editor (add/modify cases). Set in Vercel; the
# /admin page prompts for it and sends it as a Bearer token.
ADMIN_SECRET=

# Resend — "new gami" email notifications (refresh no-ops if RESEND_API_KEY unset)
RESEND_API_KEY=
EMAIL_TO=willgrannis@gmail.com
EMAIL_FROM=SCOTUSgami <onboarding@resend.dev>
